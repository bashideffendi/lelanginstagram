{
  "manifest_version": 3,
  "name": "Lelang Insta — penarik komentar lelang Instagram",
  "version": "1.2.0",
  "description": "Menarik komentar postingan lelang Instagram beserta jam aslinya, lalu menyerahkannya ke Lelang Insta untuk diperiksa.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://lelanginsta-api.tempuscollective.com/*",
    "http://localhost:8791/*",
    "http://127.0.0.1:8791/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lelanginsta.tempuscollective.com/*",
        "https://lelanginstagram.vercel.app/*",
        "http://localhost:8777/*",
        "http://127.0.0.1:8777/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
