# Salin jadi lelanginsta.env, isi nilainya, lalu: chmod 600 lelanginsta.env
#
# Berkas ini memuat sesi Instagram. Jangan pernah di-commit — sudah ditutup
# .gitignore, tapi tetap periksa sebelum push.

# Cookie dari akun Instagram KHUSUS, bukan akun yang dipakai ikut lelang.
# Ambil di browser: F12 -> Application -> Cookies -> https://www.instagram.com
# Ketiganya harus dari sesi yang sama. Mengirim sessionid sendirian membuat
# Instagram menganggap sesinya cacat dan menolak permintaannya.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRFTOKEN=

# Kosongkan supaya kotak tempel-link terbuka untuk umum.
# Diisi = hanya yang tahu kuncinya yang bisa memakai.
KETOK_KEY=

# Alamat halaman yang boleh memanggil server ini, dipisah koma.
ASAL_DIIZINKAN=https://lelanginsta.tempuscollective.com,https://lelanginstagram.vercel.app

# Hanya mendengar di localhost; Apache yang menghadap ke internet.
HOST=127.0.0.1
PORT=8791

# Pengaman pemakaian terbuka.
RATE_MAX=20
MAX_PAGES=60
